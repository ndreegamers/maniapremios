# ===== Supabase (crear proyecto nuevo en supabase.com) =====
# Project URL: Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon public key (seguro exponer al browser)
# Dashboard → Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (NUNCA exponer al cliente — solo usar en API routes)
# Dashboard → Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ===== Admin panel =====
# Contraseña para acceder a /admin (mínimo 12 caracteres recomendado)
ADMIN_PASSWORD=

# Cookie secret (declarado por compatibilidad, no usado activamente en el código)
ADMIN_COOKIE_SECRET=

# ===== DNI lookup =====
# Registrar cuenta en https://apiperu.dev → obtener Bearer token
DNI_API_TOKEN=
DNI_API_URL=https://apiperu.dev/api/dni

# ===== Modo preview (opcional) =====
# Activa datos mock sin necesidad de Supabase real
# NEXT_PUBLIC_PREVIEW_MODE=true
